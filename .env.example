# Copiar a .env y completar. El .env nunca se sube al repo.

# OpenSubtitles (opensubtitles.com -> perfil -> API Consumers)
OPENSUBTITLES_API_KEY=
# Opcional: con usuario y contraseña el limite sube de 5 a 20 descargas por dia
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Ruta a alass-cli (github.com/kaegi/alass/releases), para verificar y corregir la sincronia
ALASS_PATH=
