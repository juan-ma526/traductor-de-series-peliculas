# Copiar a .env y completar. El .env nunca se sube al repo.

# OpenSubtitles (opensubtitles.com -> perfil -> API Consumers)
OPENSUBTITLES_API_KEY=
# Opcional: con usuario y contraseña el limite sube de 5 a 20 descargas por dia
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Opcional: TMDB (themoviedb.org -> ajustes -> API) para identificar peliculas y series no cubiertas por AniList/TVmaze.
# Alcanza con uno de los dos; si estan ambos se usa el token.
TMDB_API_KEY=
TMDB_API_READ_ACCESS_TOKEN=

# Ruta a alass-cli (github.com/kaegi/alass/releases), para verificar y corregir la sincronia
ALASS_PATH=

# Motor por API (subtrad traducir). Formato: openai (por defecto) o anthropic
#   anthropic:  Claude con el SDK oficial (pip install -e ".[anthropic]"); modelo por defecto claude-haiku-5-5
#               con esfuerzo medium (SUBTRAD_ESFUERZO: low / medium / high),
#               SUBTRAD_API_URL solo si se usa un gateway en lugar de la API oficial
SUBTRAD_API_FORMATO=
SUBTRAD_ESFUERZO=
# Formato openai, compatible con:
#   OpenAI:     https://api.openai.com/v1      (modelo ej. gpt-4o-mini)
#   OpenRouter: https://openrouter.ai/api/v1   (modelo ej. deepseek/deepseek-chat)
#   Ollama:     http://localhost:11434/v1      (sin clave; modelo ej. qwen2.5:14b)
SUBTRAD_API_URL=
SUBTRAD_API_KEY=
SUBTRAD_MODELO=
